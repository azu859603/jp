APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1

DATABASE = jp
USERNAME =
PASSWORD =
HOSTPORT = 3306
CHARSET = utf8mb4
DEBUG = true

[LANG]
default_lang = zh-cn
detect_browser = false

[CACHE]

DRIVER = redis

[REDIS]
HOST = 127.0.0.1
PORT = 6379
PASSWORD =
SELECT = 0
PREFIX = jp_a:

[UPLOAD]
; 图片上传大小上限（MB）。nginx 的 client_max_body_size、PHP 的 upload_max_filesize / post_max_size 必须不小于它
MAX_SIZE_MB = 20
