{
    "name": "topthink/think",
    "description": "竞拍网站",
    "type": "project",
    "keywords": ["framework", "thinkphp", "auction"],
    "homepage": "https://www.thinkphp.cn/",
    "license": "Apache-2.0",
    "require": {
        "php": ">=7.2.5",
        "topthink/framework": "^6.1.0",
        "topthink/think-multi-app": "^1.1",
        "topthink/think-view": "^2.0"
    },
    "require-dev": {
        "topthink/think-trace": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
