<!-- 编辑弹层 -->
<div class="mask" id="editMask">
    <div class="dialog">
        <div class="dialog-title" id="editTitle">新增分类</div>
        <div class="dialog-body">
            <input type="hidden" id="editId" value="0">
            <div class="form-group">
                <label>分类名称 <span class="req">*</span></label>
                <input type="text" class="form-control" id="editName" placeholder="请输入分类名称">
            </div>
            <div class="form-group">
                <label>图标（可选，支持Emoji）</label>
                <input type="text" class="form-control" id="editIcon" placeholder="例如：📱">
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>排序（数字越小越靠前）</label>
                    <input type="number" class="form-control" id="editSort" value="0">
                </div>
                <div class="form-group">
                    <label>状态</label>
                    <select class="form-control" id="editStatus">
                        <option value="1">显示</option>
                        <option value="0">隐藏</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="dialog-footer">
            <button class="btn" onclick="document.getElementById('editMask').classList.remove('show')">取消</button>
            <button class="btn btn-primary" onclick="doSave()">保存</button>
        </div>
    </div>
</div>

<script>
var editData = [];

function openEdit(id){
    document.getElementById('editId').value = id;
    document.getElementById('editName').value = '';
    document.getElementById('editIcon').value = '';
    document.getElementById('editSort').value = 0;
    document.getElementById('editStatus').value = 1;
    document.getElementById('editTitle').textContent = '新增分类';
    if(id > 0){
        editData.forEach(function(c){
            if(c.id == id){
                document.getElementById('editName').value = c.name;
                document.getElementById('editIcon').value = c.icon;
                document.getElementById('editSort').value = c.sort;
                document.getElementById('editStatus').value = c.status;
                document.getElementById('editTitle').textContent = '编辑分类';
            }
        });
    }
    document.getElementById('editMask').classList.add('show');
}

function doSave(){
    var data = {
        id: document.getElementById('editId').value,
        name: document.getElementById('editName').value.trim(),
        icon: document.getElementById('editIcon').value.trim(),
        sort: document.getElementById('editSort').value,
        status: document.getElementById('editStatus').value
    };
    if(!data.name){ alert('请输入分类名称'); return; }
    ajaxPost('/admin/category/save', data, function(res){
        alert(res.msg);
        if(res.code == 1) location.reload();
    });
}

function del(id){
    confirmDialog('确定删除该分类吗？', function(){
        ajaxPost('/admin/category/delete', {id:id}, function(res){
            alert(res.msg); if(res.code == 1) location.reload();
        });
    });
}
</script>

